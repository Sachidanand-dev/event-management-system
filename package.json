{
  "name": "nexevent-management",
  "version": "1.0.0",
  "description": "NexEvent - Full-Stack College Event Management Hub",
  "main": "server/server.js",
  "scripts": {
    "install:server": "npm install --prefix server",
    "install:client": "npm install --prefix client --include=dev",
    "install:all": "npm install --prefix server && npm install --prefix client --include=dev",
    "postinstall": "npm run install:all",
    "build": "npm run build --prefix client",
    "start": "node server/server.js",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "lint": "npm run lint --prefix client"
  },
  "keywords": [
    "event-management",
    "college",
    "express",
    "react",
    "mongodb"
  ],
  "author": "",
  "license": "ISC"
}
