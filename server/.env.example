# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local MongoDB Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/event_management?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/event_management

# Secret key for JWT token signing
JWT_SECRET=change_this_to_a_secure_random_secret_in_production

# Optional: Allowed CORS client origin (comma separated for multiple origins)
# Example: https://nexevent.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173
